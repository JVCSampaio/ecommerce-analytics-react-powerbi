	partition dim_cliente = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(Web.Contents(UrlBaseDados, [RelativePath = "dim_cliente.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id_cliente", Int64.Type}, {"uf", type text}, {"faixa_etaria", type text}, {"data_cadastro", type date}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
