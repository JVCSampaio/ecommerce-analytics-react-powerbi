	partition fato_vendas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(Web.Contents(UrlBaseDados, [RelativePath = "fato_vendas.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id_pedido", Int64.Type}, {"data_pedido", type date}, {"id_cliente", Int64.Type}, {"id_produto", Int64.Type}, {"uf", type text}, {"canal", type text}, {"forma_pagamento", type text}, {"status", type text}, {"quantidade", Int64.Type}, {"preco_unitario", type number}, {"valor_bruto", type number}, {"desconto", type number}, {"receita_liquida", type number}, {"custo_total", type number}, {"valor_frete", type number}, {"prazo_entrega_dias", Int64.Type}, {"entregue_no_prazo", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
