table fato_vendas
	lineageTag: 7a295a37-e8b4-5020-b6ab-3cca71118ea8

	measure 'Receita Líquida' = CALCULATE ( SUM ( fato_vendas[receita_liquida] ), fato_vendas[status] = "Entregue" )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Vendas
		lineageTag: 0099e555-b7cd-50d8-b6f3-fa04ff477063

	measure Custo = CALCULATE ( SUM ( fato_vendas[custo_total] ), fato_vendas[status] = "Entregue" )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Vendas
		lineageTag: 9e439f7a-bca4-500f-8c93-fa8813635ff7

	measure 'Lucro Bruto' = [Receita Líquida] - [Custo]
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Vendas
		lineageTag: d4862801-977b-5d38-8f71-c44ac7cc0c4c

	measure 'Margem Bruta %' = DIVIDE ( [Lucro Bruto], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Vendas
		lineageTag: 50b9cb6f-a6af-5cb0-9a5e-2bd43c8f7269

	measure Pedidos = COUNTROWS ( fato_vendas )
		formatString: #,0
		displayFolder: Pedidos
		lineageTag: 01eae85f-5620-50fa-a0a3-3083c1a33937

	measure 'Pedidos Entregues' = CALCULATE ( COUNTROWS ( fato_vendas ), fato_vendas[status] = "Entregue" )
		formatString: #,0
		displayFolder: Pedidos
		lineageTag: 3f71e554-3098-51d3-868b-4a60b6fd5c03

	measure 'Ticket Médio' = DIVIDE ( [Receita Líquida], [Pedidos Entregues] )
		formatString: \R$ #,0.00;-\R$ #,0.00;\R$ #,0.00
		displayFolder: Pedidos
		lineageTag: 70a0dc2a-f63e-571e-a260-1cd8a754c740

	measure 'Itens Vendidos' = CALCULATE ( SUM ( fato_vendas[quantidade] ), fato_vendas[status] = "Entregue" )
		formatString: #,0
		displayFolder: Pedidos
		lineageTag: a371627d-caf4-5ff2-9755-569af0a5e817

	measure 'Clientes Ativos' = CALCULATE ( DISTINCTCOUNT ( fato_vendas[id_cliente] ), fato_vendas[status] = "Entregue" )
		formatString: #,0
		displayFolder: Clientes
		lineageTag: 3adc78c2-6d9b-58ba-b408-79a7cdc7989d

	measure 'Desconto Médio %' =
			DIVIDE (
			    CALCULATE ( SUM ( fato_vendas[desconto] ), fato_vendas[status] = "Entregue" ),
			    CALCULATE ( SUM ( fato_vendas[valor_bruto] ), fato_vendas[status] = "Entregue" )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Vendas
		lineageTag: 17757886-944e-5394-b1c8-66ec0e552c87

	measure 'Taxa de Cancelamento %' = DIVIDE ( CALCULATE ( COUNTROWS ( fato_vendas ), fato_vendas[status] = "Cancelado" ), [Pedidos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operação
		lineageTag: b7a2fc8d-dbcb-5b0f-9824-d63249d211e2

	measure 'Taxa de Devolução %' = DIVIDE ( CALCULATE ( COUNTROWS ( fato_vendas ), fato_vendas[status] = "Devolvido" ), [Pedidos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operação
		lineageTag: 623d592c-46fa-52c1-b02e-459aa81b82c1

	measure 'Entregas no Prazo %' =
			DIVIDE (
			    CALCULATE ( SUM ( fato_vendas[entregue_no_prazo] ), fato_vendas[status] = "Entregue" ),
			    [Pedidos Entregues]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operação
		lineageTag: 44c3d01d-f404-5339-843c-941626836274

	measure 'Prazo Médio (dias)' = CALCULATE ( AVERAGE ( fato_vendas[prazo_entrega_dias] ), fato_vendas[status] = "Entregue" )
		formatString: 0.0
		displayFolder: Operação
		lineageTag: 413b7ce7-d7ab-5328-a24d-ddbb03a7b1ca

	measure 'Receita Ano Anterior' = CALCULATE ( [Receita Líquida], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
		lineageTag: df261bde-baff-5b03-ab9f-e7d65adb0a5f

	measure 'Crescimento YoY %' =
			VAR _anterior = [Receita Ano Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _anterior ), DIVIDE ( [Receita Líquida] - _anterior, _anterior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Tempo
		lineageTag: b6a48a12-675e-537d-ac2b-227c3f6c9294

	measure 'Receita Acumulada no Ano' = TOTALYTD ( [Receita Líquida], dim_calendario[data] )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		displayFolder: Tempo
		lineageTag: 21fdce54-dbf7-504a-8179-e53709518ac1

