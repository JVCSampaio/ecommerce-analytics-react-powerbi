model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["UrlBaseDados","dim_calendario","dim_produto","dim_cliente","dim_geografia","fato_vendas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_calendario
ref table dim_produto
ref table dim_cliente
ref table dim_geografia
ref table fato_vendas
